root = true

[*]
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# Legacy Keil sources keep their original encoding. Do not transcode them on save.
[*.{js,mjs,json,html,css}]
charset = utf-8
indent_size = 2
end_of_line = lf

[*.md]
charset = utf-8
trim_trailing_whitespace = false
